# Copiar FUERA del repo a C:\AleBet\config\production.env y reemplazar placeholders.
# Nunca versionar el archivo real ni credenciales.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
FRONTEND_URL=http://NOMBRE_O_IP_LAN_DEL_SERVIDOR:3000

PLATFORM_DATABASE_URL=postgresql://platform_app:REPLACE_WITH_PASSWORD@localhost:5432/platform_prod
PLATFORM_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://NOMBRE_O_IP_LAN_DEL_SERVIDOR:3000/api/auth/google/callback

GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_SPREADSHEET_ID=REPLACE_WITH_SPREADSHEET_ID
GOOGLE_SHEETS_SHEET_NAME=STOCK APP
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=C:\AleBet\secrets\google-service-account.json

# Archivo pgpass real fuera del repo. El password nunca va en los scripts.
PGPASSFILE=C:\AleBet\secrets\pgpass.conf

# Rutas operativas opcionales.
ALEBET_LOG_DIR=C:\AleBet\logs
ALEBET_BACKUP_DIR=C:\AleBet\backups
ALEBET_PID_FILE=C:\AleBet\platform.pid

