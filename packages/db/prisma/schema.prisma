generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform", "ale_bet", "deposito"]
}

model PlatformUser {
  id                 String      @id @default(cuid())
  email              String      @unique
  nombre             String
  password           String
  activo             Boolean     @default(true)
  estado             String      @default("pending")
  isPlatformAdmin    Boolean     @default(false)
  mustChangePassword Boolean     @default(false)
  appAccess          AppAccess[]
  sessions           Session[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@schema("platform")
}

model AppAccess {
  id        String       @id @default(cuid())
  userId    String
  user      PlatformUser @relation(fields: [userId], references: [id])
  app       AppId
  rol       String
  activo    Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@unique([userId, app])
  @@schema("platform")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  app       AppId
  tipo      String
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, leida, createdAt])
  @@schema("platform")
}

model Session {
  id             String       @id @default(cuid())
  platformUserId String
  user           PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  userAgent      String?
  ip             String?

  @@index([platformUserId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@schema("platform")
}

model PlatformAuditoria {
  id           String   @id @default(cuid())
  actorId      String?
  targetUserId String?
  action       String
  app          AppId?
  previous     Json?
  next         Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@schema("platform")
}

enum AppId {
  deposito
  ale_bet
  portal
  admin

  @@schema("platform")
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED

  @@schema("platform")
}

model IdempotencyRecord {
  id             String            @id @default(cuid())
  actorId        String
  scope          String
  idempotencyKey String            @db.VarChar(255)
  requestHash    String            @db.VarChar(64)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?

  @@unique([actorId, scope, idempotencyKey])
  @@index([createdAt])
  @@map("idempotency_records")
  @@schema("platform")
}

// ─── Ale-Bet schema ──────────────────────────────────────────────────────────

model Producto {
  id          String      @id @default(cuid())
  nombre      String
  sku         String      @unique
  stockMinimo Int         @default(100)
  unidadesPorCaja Int
  activo      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lotes       Lote[]
  itemsPedido ItemPedido[]
  saldos      SaldoStock[]

  @@schema("ale_bet")
}

model Lote {
  id               String    @id @default(cuid())
  numero           String
  productoId       String
  producto         Producto  @relation(fields: [productoId], references: [id])
  cajas            Int       @default(0)
  sueltos          Int       @default(0)
  fechaProduccion  DateTime?
  fechaVencimiento DateTime?
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  reservas         ReservaStock[]
  saldos           SaldoStock[]

  @@unique([numero, productoId])
  @@unique([id, productoId])
  @@schema("ale_bet")
}

model Cliente {
  id            String       @id @default(cuid())
  nombre        String       @unique
  contacto      String?
  referencia    String?
  direccion     String?
  localidad     String?
  provincia     String?
  cuit          String?
  condicionIva  String?
  condicionVenta String?
  estado        EstadoCliente @default(VALIDADO)
  activo        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  pedidos       Pedido[]

  @@schema("ale_bet")
}

model Pedido {
  id         String       @id @default(cuid())
  numero     String       @unique
  clienteId  String
  cliente    Cliente      @relation(fields: [clienteId], references: [id])
  vendedorId String
  armadorId  String?
  estado     EstadoPedido @default(BORRADOR)
  version    Int          @default(1)
  cancelacionSolicitadaAt DateTime?
  cancelacionSolicitadaPor String?
  motivoCancelacion String?
  aprobadoAt DateTime?
  preparadoAt DateTime?
  despachadoAt DateTime?
  canceladoAt DateTime?
  items      ItemPedido[]
  reservas   ReservaStock[]
  auditorias PedidoAuditoria[]
  remitos    Remito[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@schema("ale_bet")
}

model ItemPedido {
  id         String   @id @default(cuid())
  pedidoId   String
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int
  completado Boolean  @default(false)
  createdAt  DateTime @default(now())
  reservas   ReservaStock[]

  @@schema("ale_bet")
}

model MovimientoStock {
  id         String         @id @default(cuid())
  productoId String
  cantidad   Int
  tipo       TipoMovimiento
  referencia String?
  usuarioId  String
  pedidoId   String?
  loteId     String?
  reservaId  String?
  origenUbicacionId  String?
  destinoUbicacionId String?
  idempotencyKey     String?         @unique
  origenUbicacion    UbicacionStock? @relation("MovimientoOrigenUbicacion", fields: [origenUbicacionId], references: [id])
  destinoUbicacion   UbicacionStock? @relation("MovimientoDestinoUbicacion", fields: [destinoUbicacionId], references: [id])
  createdAt  DateTime       @default(now())

  @@schema("ale_bet")
}

model ReservaStock {
  id            String        @id @default(cuid())
  pedidoId      String
  pedido        Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  // Released reservations remain as allocation evidence after an APROBADO edit.
  // The live item may be replaced, so retain the reservation and detach its link.
  itemPedidoId  String?
  itemPedido    ItemPedido?   @relation(fields: [itemPedidoId], references: [id], onDelete: SetNull)
  loteId        String
  lote          Lote          @relation(fields: [loteId], references: [id], onDelete: Restrict)
  ubicacionId   String
  ubicacion     UbicacionStock @relation(fields: [ubicacionId], references: [id], onDelete: Restrict)
  cantidad      Int
  estado        EstadoReserva @default(ACTIVA)
  createdAt     DateTime      @default(now())
  releasedAt    DateTime?
  consumedAt    DateTime?

  @@unique([itemPedidoId, loteId, ubicacionId])
  @@index([loteId, estado])
  @@index([pedidoId, estado])
  @@schema("ale_bet")
}

model UbicacionStock {
  id                   String           @id @default(cuid())
  codigo               String           @unique
  nombre               String
  activo               Boolean          @default(true)
  createdAt            DateTime         @default(now())
  saldos               SaldoStock[]
  reservas             ReservaStock[]
  movimientosOrigen    MovimientoStock[] @relation("MovimientoOrigenUbicacion")
  movimientosDestino   MovimientoStock[] @relation("MovimientoDestinoUbicacion")

  @@schema("ale_bet")
}

model SaldoStock {
  id          String         @id @default(cuid())
  productoId  String
  loteId      String
  ubicacionId String
  cantidad    Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  producto    Producto       @relation(fields: [productoId], references: [id], onDelete: Restrict)
  lote        Lote           @relation(fields: [loteId, productoId], references: [id, productoId], onDelete: Restrict)
  ubicacion   UbicacionStock @relation(fields: [ubicacionId], references: [id], onDelete: Restrict)

  @@unique([productoId, loteId, ubicacionId])
  @@schema("ale_bet")
}

model PedidoAuditoria {
  id        String   @id @default(cuid())
  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  actorId   String
  accion    String
  motivo    String?
  anterior  Json?
  nuevo     Json?
  createdAt DateTime @default(now())

  @@index([pedidoId, createdAt])
  @@schema("ale_bet")
}

model Transportista {
  id        String   @id @default(cuid())
  nombre    String
  direccion String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  remitos   Remito[]

  @@unique([nombre, direccion])
  @@schema("ale_bet")
}

model Remito {
  id                   String       @id @default(cuid())
  pedidoId             String
  pedido               Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  numero               String       @unique
  fecha                DateTime     @default(now())
  transportistaId      String?
  transportista        Transportista? @relation(fields: [transportistaId], references: [id])
  transporteNombre     String
  transporteDireccion  String
  clienteSnapshot      Json
  transporteSnapshot   Json
  itemsSnapshot        Json
  estado               EstadoRemito @default(VIGENTE)
  invalidadoAt         DateTime?
  invalidadoPor        String?
  motivoInvalidacion   String?
  createdBy            String
  createdAt            DateTime     @default(now())

  @@index([pedidoId, estado])
  @@schema("ale_bet")
}

enum EstadoPedido {
  BORRADOR
  APROBADO
  EN_ARMADO
  PREPARADO
  DESPACHADO
  CANCELADO

  @@schema("ale_bet")
}

enum EstadoCliente {
  PENDIENTE_CLIENTE
  VALIDADO

  @@schema("ale_bet")
}

enum EstadoReserva {
  ACTIVA
  LIBERADA
  CONSUMIDA

  @@schema("ale_bet")
}

enum EstadoRemito {
  VIGENTE
  INVALIDADO

  @@schema("ale_bet")
}

enum TipoMovimiento {
  ENTRADA_MANUAL
  SALIDA_PEDIDO
  AJUSTE
  TRANSFERENCIA_INTERNA

  @@schema("ale_bet")
}

// ─── Deposito schema ────────────────────────────────────────────────────────
// Depósito - Schema v1 (Fase 1: Drogas + Actas + Movimientos)




// ============================================================
// USERS
// ============================================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(observador)
  platformUserId String? @unique @map("platform_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  actas                  Acta[]
  movimientos            Movimiento[]
  insumoPendientes       InsumoPendiente[]
  ordenesComoSolicitante OrdenProduccion[] @relation("OrdenesComoSolicitante")
  ordenesComoAprobador   OrdenProduccion[] @relation("OrdenesComoAprobador")
  auditoriasCatalogo     AuditoriaCatalogoProducto[]
  importacionesInicialesEstuche ImportacionInicialEstucheBatch[]

  @@map("users")

  @@schema("deposito")
}

enum Role {
  encargado
  observador
  solicitante

  @@schema("deposito")
}

// ============================================================
// ACTAS
// ============================================================
model Acta {
  id        String     @id @default(uuid())
  fecha     DateTime   @db.Date
  createdBy String     @map("created_by")
  estado    EstadoActa @default(pendiente)
  notas     String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user  User       @relation(fields: [createdBy], references: [id])
  items ActaItem[]

  @@map("actas")

  @@schema("deposito")
}

enum EstadoActa {
  pendiente
  parcial
  completada

  @@schema("deposito")
}

// ============================================================
// ACTA ITEMS
// ============================================================
model ActaItem {
  id                  String    @id @default(uuid())
  actaId              String    @map("acta_id")
  productoId          String?   @map("producto_id")
  categoria           Categoria
  productoNombre      String    @map("producto_nombre")
  lote                String
  vencimiento         DateTime? @db.Date @map("vencimiento")
  temperaturaTransporte String? @map("temperatura_transporte")
  condicionEmbalaje   CondicionEmbalaje? @map("condicion_embalaje")
  observacionesCalidad String? @map("observaciones_calidad")
  aprobadoCalidad     Boolean   @default(false) @map("aprobado_calidad")
  cantidadIngresada   Float       @map("cantidad_ingresada")
  cantidadDistribuida Float       @default(0) @map("cantidad_distribuida")
  mercado             Mercado?  // solo para categoría estuche/etiqueta
  createdAt           DateTime  @default(now()) @map("created_at")

  acta     Acta      @relation(fields: [actaId], references: [id], onDelete: Cascade)
  producto DepositoProducto? @relation(fields: [productoId], references: [id])

  @@index([productoId])
  @@map("acta_items")

  @@schema("deposito")
}

enum Categoria {
  droga
  estuche
  etiqueta
  frasco

  @@schema("deposito")
}

enum Mercado {
  argentina
  colombia
  mexico
  ecuador
  bolivia
  paraguay
  VENEZUELA
  no_exportable

  @@schema("deposito")
}

enum CondicionEmbalaje {
  bueno
  regular
  malo

  @@schema("deposito")
}

enum EstadoProductoCatalogo {
  PENDIENTE_REVISION
  ACTIVO
  INACTIVO

  @@schema("deposito")
}

enum OrigenProductoCatalogo {
  MANUAL
  IMPORTACION
  IMPORTACION_INICIAL_ESTUCHES
  MIGRACION

  @@schema("deposito")
}

enum TipoAuditoriaCatalogo {
  CREADO
  EDITADO
  CODIGO_ACTUALIZADO
  NOMBRE_ACTUALIZADO
  PRESENTACION_ACTUALIZADA
  ACTIVADO
  REACTIVADO
  DESACTIVADO
  IMPORTACION_CREADA
  IMPORTACION_APROBADA

  @@schema("deposito")
}

model AuditoriaCatalogoProducto {
  id            String                @id @default(uuid())
  productoId    String                @map("producto_id")
  tipo          TipoAuditoriaCatalogo
  valorAnterior Json?                 @map("valor_anterior")
  valorNuevo    Json?                 @map("valor_nuevo")
  usuarioId     String                @map("usuario_id")
  createdAt     DateTime              @default(now()) @map("created_at")

  producto DepositoProducto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  usuario  User             @relation(fields: [usuarioId], references: [id])

  @@index([productoId, createdAt])
  @@map("auditorias_catalogo_producto")
  @@schema("deposito")
}

// ============================================================
// INVENTARIO DROGAS
// ============================================================
model InventarioDroga {
  id          String    @id @default(uuid())
  productoId  String?   @map("producto_id")
  nombre      String
  lote        String?
  vencimiento DateTime? @db.Date @map("vencimiento")
  cantidad    Float       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  producto DepositoProducto? @relation(fields: [productoId], references: [id])

  @@unique([nombre, lote])
  @@index([productoId])
  @@index([productoId, lote])
  @@unique([productoId, lote])
  @@map("inventario_drogas")

  @@schema("deposito")
}

// ============================================================
// INVENTARIO ESTUCHES
// ============================================================
model InventarioEstuche {
  id         String   @id @default(uuid())
  productoId String?  @map("producto_id")
  articulo   String
  mercado    Mercado
  cantidad   Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  producto DepositoProducto? @relation(fields: [productoId], references: [id])
  importacionInicialItem ImportacionInicialEstucheItem?

  @@unique([articulo, mercado])
  @@index([productoId])
  @@index([productoId, mercado])
  @@unique([productoId, mercado])
  @@map("inventario_estuches")

  @@schema("deposito")
}

// ============================================================
// INVENTARIO ETIQUETAS
// ============================================================
model InventarioEtiqueta {
  id         String   @id @default(uuid())
  productoId String?  @map("producto_id")
  articulo   String
  mercado    Mercado
  cantidad   Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  producto DepositoProducto? @relation(fields: [productoId], references: [id])

  @@unique([articulo, mercado])
  @@index([productoId])
  @@index([productoId, mercado])
  @@unique([productoId, mercado])
  @@map("inventario_etiquetas")

  @@schema("deposito")
}

// ============================================================
// INVENTARIO FRASCOS
// ============================================================
model InventarioFrasco {
  id              String   @id @default(uuid())
  productoId      String?  @map("producto_id")
  articulo        String
  unidadesPorCaja Int      @map("unidades_por_caja")
  cantidadCajas   Int      @default(0) @map("cantidad_cajas")
  total           Int      @default(0)
  updatedAt       DateTime @updatedAt @map("updated_at")

  producto DepositoProducto? @relation(fields: [productoId], references: [id])

  @@index([productoId])
  @@unique([productoId])
  @@map("inventario_frascos")

  @@schema("deposito")
}

// ============================================================
// MOVIMIENTOS (auditoría)
// ============================================================
model Movimiento {
  id             String         @id @default(uuid())
  tipo           DepositoTipoMovimiento
  categoria      Categoria
  productoNombre String         @map("producto_nombre")
  lote           String?
  cantidad       Float // positivo = ingreso, negativo = egreso
  referenciaId   String?        @map("referencia_id")
  referenciaTipo RefTipo?       @map("referencia_tipo")
  productoId     String?        @map("producto_id")
  fechaEfectiva  DateTime?     @db.Date @map("fecha_efectiva")
  importacionInicialEstucheItemId String? @unique @map("importacion_inicial_estuche_item_id")
  justificacion  String?
  createdBy      String         @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [createdBy], references: [id])
  producto DepositoProducto? @relation(fields: [productoId], references: [id])
  importacionInicialEstucheItem ImportacionInicialEstucheItem? @relation(fields: [importacionInicialEstucheItemId], references: [id])

  @@map("movimientos")
  @@index([productoId])

  @@schema("deposito")
}

enum RefTipo {
  acta_item
  orden

  @@schema("deposito")
}

enum DepositoTipoMovimiento {
  ingreso_acta
  egreso_orden
  ajuste_manual
  stock_inicial

  @@schema("deposito")
}

// ============================================================
// INSUMOS PENDIENTES
// ============================================================
model InsumoPendiente {
  id                   String          @id @default(uuid())
  categoria            String          @default("frasco")
  articulo             String
  cantidad             Int
  destino              String
  estado               EstadoPendiente @default(en_esterilizacion)
  fechaEnvio           DateTime        @db.Date @map("fecha_envio")
  fechaRetornoEstimada DateTime?       @db.Date @map("fecha_retorno_estimada")
  fechaRecibido        DateTime?       @db.Date @map("fecha_recibido")
  notas                String?
  createdBy            String          @map("created_by")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [createdBy], references: [id])

  @@map("insumos_pendientes")

  @@schema("deposito")
}

enum EstadoPendiente {
  en_esterilizacion
  recibido

  @@schema("deposito")
}

// ============================================================
// ÓRDENES DE PRODUCCIÓN
// ============================================================
model OrdenProduccion {
  id             String      @id @default(uuid())
  solicitanteId  String      @map("solicitante_id")
  aprobadoPor    String?     @map("aprobado_por")
  productoId     String?     @map("producto_id")
  categoria      Categoria
  productoNombre String      @map("producto_nombre")
  mercado        Mercado?
  cantidad       Int
  urgencia       Urgencia    @default(normal)
  estado         EstadoOrden @default(solicitada)
  motivoRechazo  String?     @map("motivo_rechazo")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  solicitante User      @relation("OrdenesComoSolicitante", fields: [solicitanteId], references: [id])
  aprobador   User?     @relation("OrdenesComoAprobador", fields: [aprobadoPor], references: [id])
  producto    DepositoProducto? @relation(fields: [productoId], references: [id])

  @@index([productoId])
  @@map("ordenes_produccion")

  @@schema("deposito")
}

enum Urgencia {
  normal
  urgente

  @@schema("deposito")
}

enum EstadoOrden {
  solicitada
  aprobada
  ejecutada
  completada
  rechazada

  @@schema("deposito")
}

// ============================================================
// CATÁLOGO DE PRODUCTOS
// ============================================================
model DepositoProducto {
  id             String    @id @default(uuid())
  nombreBase     String    @map("nombre_base")
  volumen        Decimal?  @db.Decimal(10, 3)
  unidad         String?
  variante       String?
  categoria      Categoria
  nombreCompleto String    @map("nombre_completo")
  activo         Boolean   @default(true)
  estado         EstadoProductoCatalogo? @map("estado")
  codigo         String?   @unique
  origen         OrigenProductoCatalogo @default(MIGRACION)
  presentacion   Int?
  mercadosHabilitados Mercado[] @default([]) @map("mercados_habilitados")
  mercado              Mercado?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  inventarioDrogas    InventarioDroga[]
  inventarioEstuches  InventarioEstuche[]
  inventarioEtiquetas InventarioEtiqueta[]
  inventarioFrascos   InventarioFrasco[]
  actaItems           ActaItem[]
  ordenes             OrdenProduccion[]
  auditoriasCatalogo   AuditoriaCatalogoProducto[]
  movimientos          Movimiento[]
  importacionesInicialesEstuche ImportacionInicialEstucheItem[]

  @@unique([nombreCompleto, categoria, mercado])
  @@map("productos")

  @@schema("deposito")
}

model SecuenciaCodigoEstuche {
  mercado Mercado @id
  ultimo  Int     @default(0)

  @@map("secuencias_codigo_estuche")
  @@schema("deposito")
}

model SecuenciaCodigoEtiqueta {
  mercado Mercado @id
  ultimo  Int     @default(0)

  @@map("secuencias_codigo_etiqueta")
  @@schema("deposito")
}

model SecuenciaCodigoFrasco {
  id     String @id @default("canonical")
  ultimo Int    @default(62)

  @@map("secuencias_codigo_frasco")
  @@schema("deposito")
}

model ImportacionInicialEstucheBatch {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique @map("idempotency_key")
  checksum       String   @unique
  actorId        String   @map("actor_id")
  effectiveDate  DateTime @db.Date @map("effective_date")
  result         Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  actor User @relation(fields: [actorId], references: [id])
  items ImportacionInicialEstucheItem[]
  idempotencyKeys ImportacionInicialEstucheIdempotencyKey[]

  @@map("importaciones_iniciales_estuche")
  @@schema("deposito")
}

model ImportacionInicialEstucheIdempotencyKey {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique @map("idempotency_key")
  batchId        String   @map("batch_id")
  createdAt      DateTime @default(now()) @map("created_at")

  batch ImportacionInicialEstucheBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@map("importaciones_iniciales_estuche_idempotency_keys")
  @@schema("deposito")
}

model ImportacionInicialEstucheItem {
  id           String   @id @default(uuid())
  batchId      String   @map("batch_id")
  productoId   String   @unique @map("producto_id")
  inventarioEstucheId String @unique @map("inventario_estuche_id")
  mercado      Mercado
  codigo       String
  sourceRow    Int      @map("source_row")
  cantidad     Int
  createdAt    DateTime @default(now()) @map("created_at")

  batch ImportacionInicialEstucheBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  producto DepositoProducto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  inventario InventarioEstuche @relation(fields: [inventarioEstucheId], references: [id], onDelete: Restrict)
  movimiento Movimiento?

  @@unique([batchId, sourceRow])
  @@map("importaciones_iniciales_estuche_items")
  @@schema("deposito")
}
