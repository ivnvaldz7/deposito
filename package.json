{
  "name": "platform",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:prod": "npm --workspace @platform/db run build && npm --workspace @platform/core run build && npm --workspace @platform/server run build && npm --workspace @platform/client run build:static",
    "dev": "node scripts/dev-uat.mjs",
    "dev:clean": "node scripts/dev-clean.mjs",
    "dev:status": "node scripts/dev-status.mjs",
    "dev:turbo": "turbo run dev --filter=./apps/platform/* --filter=./packages/*",
    "lint": "eslint apps packages scripts --max-warnings 0",
    "start:prod": "npm --workspace @platform/server run start",
    "db:migrate": "npm --workspace @platform/server run db:migrate",
    "db:seed:staging-users": "npm --workspace @platform/server run db:seed-users:staging",
    "db:setup:staging": "npm run db:migrate && npm run db:seed:staging-users",
    "db:setup": "npm --workspace @platform/server run db:setup",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "esbuild": "^0.28.1",
    "globals": "^17.12.0",
    "turbo": "^2.5.4",
    "typescript-eslint": "^8.70.0"
  }
}
